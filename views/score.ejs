<main class="score-page">
    <section class="card score-card">
        <div class="card-body">
            <h1 class="h3 text-center mb-4">Game Scores</h1>

            <div class="table-responsive">
                <table class="table table-bordered table-light score-table">
                    <thead>
                        <tr>
                            <th scope="col">Attempt</th>
                            <th scope="col">Score (Rounds)</th>
                            <th scope="col">Date Played</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (scores.length === 0) { %>
                        <tr>
                            <td colspan="3">No scores yet.</td>
                        </tr>
                        <% } else { %>
                            <% scores.forEach((score, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= score.score %></td>
                                    <td><%= new Date(score.createdAt).toLocaleString() %></td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>
